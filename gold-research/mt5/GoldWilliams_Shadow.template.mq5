//+------------------------------------------------------------------+
//| GoldWilliams_Shadow.mq5  (GENERATED by code/build_shadow_ea.py)  |
//| Williams volatility breakout #112 - trading logic IDENTICAL to   |
//| GoldWilliams.mq5 (v1.00). Lot size is NOT changed by the model.  |
//| SHADOW: at each entry it computes the 206 three-indicator        |
//| features (H1/H4/D1 built from H1 bars, NY 17:00 days) and the    |
//| frozen RF model of research #150 (300 trees, trained 2005-2023), |
//| and LOGS the size it would have used (0.5-1.5). Nothing else.    |
//| Magic 770502. Run it INSTEAD of GoldWilliams (770501), not with. |
//+------------------------------------------------------------------+
#property copyright "gold-research"
#property version   "1.01"
#property description "Williams #112 + SHADOW RF sizing (logged only, never applied). Research #149-#153: model = 'probable, not proven'."
#property description "Logs: MQL5/Files/GoldWilliams_Shadow_trades.csv, _signals.csv, _bars.csv"
#include <Trade/Trade.mqh>

#define K_RANGE      0.6       // research rule (frozen)
#define EXIT_NY_MIN  1018      // 16:58 New York (= research 'day close')

input group "Size (actual trades - unchanged Williams)"
input double InpLev        = 0.5;    // Notional as x equity
input double InpFixedLot   = 0.0;    // Fixed lot (>0 overrides)
input group "Shadow"
input bool   InpShadow     = true;   // Compute + log the AI size (never applied)
input int    InpHistBars   = 20000;  // H1 bars used for the features (research check: >=15000 -> size error ~0.01)
input int    InpMinBars    = 15000;  // Min usable bars to compute (live: keep 15000; Strategy Tester parity run: e.g. 4000)
input bool   InpDumpBars   = true;   // Write H1 bars once per trading day (overwrite; for the Python parity check)
input group "Technical"
input int    InpServerUTC  = 0;      // Broker server offset from UTC (Exness = 0)
input long   InpMagic      = 770502; // Magic number
input int    InpDeviation  = 30;     // Max deviation, points
input double InpMaxSpread  = 0.0;    // Skip entry if spread > this (USD); 0 = off
input string InpCsvName    = "GoldWilliams_Shadow_trades.csv";
input string InpSigName    = "GoldWilliams_Shadow_signals.csv";
input string InpBarsName   = "GoldWilliams_Shadow_bars.csv";

CTrade trade;
datetime dayKey = 0;
double   dOpen = 0, buyLvl = 0, sellLvl = 0, prevRange = 0;
bool     tradedToday = false;
ulong    pendClose[];
ulong gTicket = 0; long gPosId = 0; int gSide = 0; double gLvl = 0, gEnt = 0, gVol = 0, gSpr = 0; datetime gEntT = 0;
// shadow results of the open trade
bool   gStale = false;
bool   gShOk = false; double gShPred = 0, gShPct = 0, gShSize = 1.0; string gShNote = ""; double gFeat[];
double NANV = 0;

//==================================================================== time (unchanged)
datetime ToUTC(datetime s) { return (datetime)((long)s - (long)InpServerUTC * 3600); }
datetime NthSundayUTC(int y, int mon, int nth, int hUTC)
  {
   MqlDateTime d; ZeroMemory(d); d.year = y; d.mon = mon; d.day = 1;
   datetime f = StructToTime(d); MqlDateTime s; TimeToStruct(f, s);
   int add = (7 - s.day_of_week) % 7;
   return (datetime)((long)f + (long)(add + 7 * (nth - 1)) * 86400 + (long)hUTC * 3600);
  }
int NYOffset(datetime utc)
  {
   MqlDateTime t; TimeToStruct(utc, t);
   return (utc >= NthSundayUTC(t.year, 3, 2, 7) && utc < NthSundayUTC(t.year, 11, 1, 6)) ? -4 : -5;
  }
datetime ToNY(datetime utc) { return (datetime)((long)utc + (long)NYOffset(utc) * 3600); }
datetime TradingDayKey(datetime utc)
  {
   datetime ny = ToNY(utc); MqlDateTime t; TimeToStruct((datetime)((long)ny + 7 * 3600), t);
   t.hour = 0; t.min = 0; t.sec = 0; return StructToTime(t);
  }
int NYMinute(datetime utc) { MqlDateTime t; TimeToStruct(ToNY(utc), t); return t.hour * 60 + t.min; }
int NYHour(datetime utc) { MqlDateTime t; TimeToStruct(ToNY(utc), t); return t.hour; }

//==================================================================== indicator port of code/ind3.py
#define BIGV 999.0
bool IsNum(double x) { return MathIsValidNumber(x); }
double Clip(double x, double a, double b) { return x < a ? a : (x > b ? b : x); }
double Sgn(double x) { return x > 0 ? 1.0 : (x < 0 ? -1.0 : 0.0); }

void Rma(const double &x[], int n, int p, double &out[])
  { ArrayResize(out, n); double a = 1.0 / p, s = x[0]; for(int i = 0; i < n; i++) { s = (i == 0) ? x[0] : s + a * (x[i] - s); out[i] = s; } }
void Ema(const double &x[], int n, int p, double &out[])
  { ArrayResize(out, n); double a = 2.0 / (p + 1), s = x[0]; for(int i = 0; i < n; i++) { s = (i == 0) ? x[0] : s + a * (x[i] - s); out[i] = s; } }
void TrueRange(const double &h[], const double &l[], const double &c[], int n, double &out[])
  {
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) { double pc = i == 0 ? c[0] : c[i - 1]; out[i] = MathMax(h[i] - l[i], MathMax(MathAbs(h[i] - pc), MathAbs(l[i] - pc))); }
  }
void Since(const bool &ev[], int n, double &out[])
  { ArrayResize(out, n); int last = -1; for(int i = 0; i < n; i++) { if(ev[i]) last = i; out[i] = last < 0 ? BIGV : (double)(i - last); } }
void RollMean(const double &x[], int n, int p, double &out[])     // pandas rolling(p, min_periods=1).mean()
  {
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) { int a = MathMax(0, i - p + 1); double s = 0; for(int k = a; k <= i; k++) s += x[k]; out[i] = s / (i - a + 1); }
  }
void RollSum(const double &x[], int n, int p, double &out[])
  {
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) { int a = MathMax(0, i - p + 1); double s = 0; for(int k = a; k <= i; k++) s += x[k]; out[i] = s; }
  }

// ---- PAC structure (LuxAlgo leg pivots + close breaks). ev[t*6+k]: 0 bos_b,1 choch_b,2 chochp_b,3 bos_s,4 choch_s,5 chochp_s
void Structure(const double &h[], const double &l[], const double &c[], int n, int size,
               double &trend[], bool &ev[], double &phl[], double &pll[], int &phiA[], int &pliA[])
  {
   ArrayResize(trend, n); ArrayResize(ev, n * 6); ArrayResize(phl, n); ArrayResize(pll, n); ArrayResize(phiA, n); ArrayResize(pliA, n);
   for(int i = 0; i < n; i++) { trend[i] = 0; phl[i] = NANV; pll[i] = NANV; phiA[i] = -1; pliA[i] = -1; }
   for(int i = 0; i < n * 6; i++) ev[i] = false;
   int leg = 0; double ph = NANV, pl = NANV; bool phx = true, plx = true; int tr = 0;
   double phPrev = NANV, plPrev = NANV; int phi = -1, pli = -1;
   for(int t = size; t < n; t++)
     {
      double hh = h[t - size + 1], ll = l[t - size + 1];
      for(int k = t - size + 1; k <= t; k++) { if(h[k] > hh) hh = h[k]; if(l[k] < ll) ll = l[k]; }
      bool newH = h[t - size] > hh, newL = l[t - size] < ll;
      int prev = leg;
      if(newH) leg = 0; else if(newL) leg = 1;
      if(leg != prev)
        {
         if(leg == 1) { plPrev = pl; pl = l[t - size]; plx = false; pli = t - size; }
         else         { phPrev = ph; ph = h[t - size]; phx = false; phi = t - size; }
        }
      if(IsNum(ph) && !phx && c[t] > ph)
        {
         phx = true;
         if(tr == -1) { bool plus = IsNum(plPrev) && pl > plPrev; if(plus) ev[t * 6 + 2] = true; else ev[t * 6 + 1] = true; }
         else ev[t * 6 + 0] = true;
         tr = 1;
        }
      if(IsNum(pl) && !plx && c[t] < pl)
        {
         plx = true;
         if(tr == 1) { bool plus = IsNum(phPrev) && ph < phPrev; if(plus) ev[t * 6 + 5] = true; else ev[t * 6 + 4] = true; }
         else ev[t * 6 + 3] = true;
         tr = -1;
        }
      trend[t] = tr; phl[t] = ph; pll[t] = pl; phiA[t] = phi; pliA[t] = pli;
     }
  }

void OrderBlocks(const double &h[], const double &l[], const double &c[], const double &atr[], const bool &brkB[], const bool &brkS[],
                 const int &phiA[], const int &pliA[], int n, int maxKeep,
                 double &nb[], double &ns[], double &db[], double &ds[], double &ib[], double &is_[])
  {
   double bt[], bb[], st_[], sb[]; ArrayResize(bt, maxKeep); ArrayResize(bb, maxKeep); ArrayResize(st_, maxKeep); ArrayResize(sb, maxKeep);
   for(int q = 0; q < maxKeep; q++) { bt[q] = NANV; bb[q] = NANV; st_[q] = NANV; sb[q] = NANV; }
   ArrayResize(nb, n); ArrayResize(ns, n); ArrayResize(db, n); ArrayResize(ds, n); ArrayResize(ib, n); ArrayResize(is_, n);
   int kb = 0, ks = 0;
   for(int t = 0; t < n; t++)
     {
      nb[t] = 0; ns[t] = 0; db[t] = 10.0; ds[t] = 10.0; ib[t] = 0; is_[t] = 0;
      if(brkB[t] && phiA[t] >= 0 && t - phiA[t] >= 2)
        { int s = phiA[t], j = s; for(int k = s; k < t; k++) if(l[k] < l[j]) j = k; bt[kb % maxKeep] = h[j]; bb[kb % maxKeep] = l[j]; kb++; }
      if(brkS[t] && pliA[t] >= 0 && t - pliA[t] >= 2)
        { int s = pliA[t], j = s; for(int k = s; k < t; k++) if(h[k] > h[j]) j = k; st_[ks % maxKeep] = h[j]; sb[ks % maxKeep] = l[j]; ks++; }
      double a = atr[t] > 0 ? atr[t] : 1e-9; int cb = 0, cs = 0;
      for(int q = 0; q < maxKeep; q++)
        {
         if(IsNum(bb[q]))
           {
            if(c[t] < bb[q]) { bb[q] = NANV; bt[q] = NANV; }
            else { cb++; double d = (c[t] - bt[q]) / a; if(d < 0) { d = 0.0; ib[t] = 1; } if(d < db[t]) db[t] = d; }
           }
         if(IsNum(st_[q]))
           {
            if(c[t] > st_[q]) { st_[q] = NANV; sb[q] = NANV; }
            else { cs++; double d = (sb[q] - c[t]) / a; if(d < 0) { d = 0.0; is_[t] = 1; } if(d < ds[t]) ds[t] = d; }
           }
        }
      nb[t] = cb; ns[t] = cs;
     }
  }

void Fvg(const double &h[], const double &l[], const double &c[], const double &atr[], int n, int maxKeep,
         bool &evb[], bool &evs[], double &nb[], double &ns[], double &db[], double &ds[])
  {
   double zb[], zbt[], zs[], zsb[]; ArrayResize(zb, maxKeep); ArrayResize(zbt, maxKeep); ArrayResize(zs, maxKeep); ArrayResize(zsb, maxKeep);
   for(int q = 0; q < maxKeep; q++) { zb[q] = NANV; zbt[q] = NANV; zs[q] = NANV; zsb[q] = NANV; }
   ArrayResize(evb, n); ArrayResize(evs, n); ArrayResize(nb, n); ArrayResize(ns, n); ArrayResize(db, n); ArrayResize(ds, n);
   for(int t = 0; t < n; t++) { evb[t] = false; evs[t] = false; nb[t] = 0; ns[t] = 0; db[t] = 10.0; ds[t] = 10.0; }
   int kb = 0, ks = 0;
   for(int t = 2; t < n; t++)
     {
      if(l[t] > h[t - 2] && c[t - 1] > h[t - 2]) { evb[t] = true; zb[kb % maxKeep] = h[t - 2]; zbt[kb % maxKeep] = l[t]; kb++; }
      if(h[t] < l[t - 2] && c[t - 1] < l[t - 2]) { evs[t] = true; zs[ks % maxKeep] = l[t - 2]; zsb[ks % maxKeep] = h[t]; ks++; }
      double a = atr[t] > 0 ? atr[t] : 1e-9; int cb = 0, cs = 0;
      for(int q = 0; q < maxKeep; q++)
        {
         if(IsNum(zb[q])) { if(l[t] <= zb[q]) zb[q] = NANV; else { cb++; double d = (c[t] - zbt[q]) / a; if(d < 0) d = 0.0; if(d < db[t]) db[t] = d; } }
         if(IsNum(zs[q])) { if(h[t] >= zs[q]) zs[q] = NANV; else { cs++; double d = (zsb[q] - c[t]) / a; if(d < 0) d = 0.0; if(d < ds[t]) ds[t] = d; } }
        }
      nb[t] = cb; ns[t] = cs;
     }
  }

void EqLevels(const double &h[], const double &l[], const double &atr[], int n, int size, double thr,
              bool &eqh[], bool &eql[], double &lvh[], double &lvl[])
  {
   ArrayResize(eqh, n); ArrayResize(eql, n); ArrayResize(lvh, n); ArrayResize(lvl, n);
   for(int i = 0; i < n; i++) { eqh[i] = false; eql[i] = false; lvh[i] = NANV; lvl[i] = NANV; }
   double lastph = NANV, lastpl = NANV, curh = NANV, curl = NANV;
   for(int t = 2 * size; t < n; t++)
     {
      int p = t - size; bool isph = true, ispl = true;
      for(int k = p - size; k <= p + size; k++) { if(k == p) continue; if(h[k] >= h[p]) isph = false; if(l[k] <= l[p]) ispl = false; }
      if(isph) { if(IsNum(lastph) && MathAbs(h[p] - lastph) < thr * atr[t]) { eqh[t] = true; curh = MathMax(h[p], lastph); } lastph = h[p]; }
      if(ispl) { if(IsNum(lastpl) && MathAbs(l[p] - lastpl) < thr * atr[t]) { eql[t] = true; curl = MathMin(l[p], lastpl); } lastpl = l[p]; }
      lvh[t] = curh; lvl[t] = curl;
     }
  }

void Divergence(const double &h[], const double &l[], const double &w[], int n, int size, bool &bull[], bool &bear[])
  {
   ArrayResize(bull, n); ArrayResize(bear, n); for(int i = 0; i < n; i++) { bull[i] = false; bear[i] = false; }
   double lph = NANV, lphw = NANV, lpl = NANV, lplw = NANV;
   for(int t = 2 * size; t < n; t++)
     {
      int p = t - size; bool isph = true, ispl = true;
      for(int k = p - size; k <= p + size; k++) { if(k == p) continue; if(h[k] >= h[p]) isph = false; if(l[k] <= l[p]) ispl = false; }
      if(isph) { if(IsNum(lph) && h[p] > lph && w[p] < lphw) bear[t] = true; lph = h[p]; lphw = w[p]; }
      if(ispl) { if(IsNum(lpl) && l[p] < lpl && w[p] > lplw) bull[t] = true; lpl = l[p]; lplw = w[p]; }
     }
  }

void StOne(const double &hl2[], const double &c[], const double &atr[], int n, double f, double &st[])
  {
   ArrayResize(st, n); double up = hl2[0] - f * atr[0], dn = hl2[0] + f * atr[0]; int t_ = 1;
   for(int i = 0; i < n; i++)
     {
      double u = hl2[i] - f * atr[i], d = hl2[i] + f * atr[i];
      if(i > 0)
        {
         u = c[i - 1] > up ? MathMax(u, up) : u; d = c[i - 1] < dn ? MathMin(d, dn) : d;
         if(t_ == 1 && c[i] < up) t_ = -1; else if(t_ == -1 && c[i] > dn) t_ = 1;
        }
      up = u; dn = d; st[i] = t_ == 1 ? up : dn;
     }
  }

void StAi(const double &h[], const double &l[], const double &c[], const double &atr[], int n, double perfAlpha,
          double &stf[], double &trf[], double &fac[], double &strength[])
  {
   int K = 9; double factors[9]; for(int k = 0; k < K; k++) factors[k] = 1.0 + 0.5 * k;
   double hl2[]; ArrayResize(hl2, n); for(int i = 0; i < n; i++) hl2[i] = (h[i] + l[i]) / 2;
   double sts[]; ArrayResize(sts, K * n);
   for(int k = 0; k < K; k++) { double s[]; StOne(hl2, c, atr, n, factors[k], s); for(int i = 0; i < n; i++) sts[k * n + i] = s[i]; }
   double perf[9]; ArrayInitialize(perf, 0.0); double a = 2.0 / (perfAlpha + 1), den = 0.0;
   ArrayResize(stf, n); ArrayResize(trf, n); ArrayResize(fac, n); ArrayResize(strength, n);
   double up = hl2[0] - 3 * atr[0], dn = hl2[0] + 3 * atr[0]; int t_ = 1; double f = 3.0;
   for(int i = 0; i < n; i++)
     {
      strength[i] = 0;
      if(i > 0)
        {
         double dc = c[i] - c[i - 1];
         for(int k = 0; k < K; k++) perf[k] += a * (dc * Sgn(c[i - 1] - sts[k * n + i - 1]) - perf[k]);
         den += a * (MathAbs(dc) - den);
         double srt[9]; for(int k = 0; k < K; k++) srt[k] = perf[k]; ArraySort(srt);
         double cen[3]; cen[0] = srt[(int)(0.25 * (K - 1))]; cen[1] = srt[(int)(0.5 * (K - 1))]; cen[2] = srt[(int)(0.75 * (K - 1))];
         int lab[9];
         for(int it = 0; it < 20; it++)
           {
            for(int k = 0; k < K; k++)
              { int b = 0; double bd = MathAbs(perf[k] - cen[0]); for(int q = 1; q < 3; q++) { double dd = MathAbs(perf[k] - cen[q]); if(dd < bd) { bd = dd; b = q; } } lab[k] = b; }
            double newc[3]; for(int q = 0; q < 3; q++) newc[q] = cen[q];
            for(int q = 0; q < 3; q++) { double s = 0; int m = 0; for(int k = 0; k < K; k++) if(lab[k] == q) { s += perf[k]; m++; } if(m > 0) newc[q] = s / m; }
            bool conv = true; for(int q = 0; q < 3; q++) if(MathAbs(newc[q] - cen[q]) >= 1e-12) conv = false;
            if(conv) break;
            for(int q = 0; q < 3; q++) cen[q] = newc[q];
           }
         int best = 0; for(int q = 1; q < 3; q++) if(cen[q] > cen[best]) best = q;
         double s = 0; int m = 0; for(int k = 0; k < K; k++) if(lab[k] == best) { s += factors[k]; m++; }
         if(m > 0) f = s / m;
         strength[i] = den > 0 ? MathMax(cen[best], 0.0) / den : 0.0;
        }
      double u = hl2[i] - f * atr[i], d = hl2[i] + f * atr[i];
      if(i > 0)
        {
         u = c[i - 1] > up ? MathMax(u, up) : u; d = c[i - 1] < dn ? MathMin(d, dn) : d;
         if(t_ == 1 && c[i] < up) t_ = -1; else if(t_ == -1 && c[i] > dn) t_ = 1;
        }
      up = u; dn = d; stf[i] = t_ == 1 ? up : dn; trf[i] = t_; fac[i] = f;
     }
  }

//---- raw value store (bull-positive values of features149 raw columns) at the selected bar
//@@RAWNAMES@@
double RAW[3][NRAW];
int gTf = 0;
void Put(string name, double v)
  {
   for(int k = 0; k < NRAW; k++) if(RAWN[k] == name) { RAW[gTf][k] = v; return; }
  }

// compute every indicator over the series and store the values at bar `s`
void ComputeRaw(const double &o[], const double &h[], const double &l[], const double &c[], const double &v[], int n, int s)
  {
   double tr[], atr[], atr14[]; TrueRange(h, l, c, n, tr); Rma(tr, n, 200, atr); Rma(tr, n, 14, atr14);
   string nms[2] = {"sw", "in"}; int sizes[2] = {50, 5};
   for(int z = 0; z < 2; z++)
     {
      string nm = nms[z];
      double trend[], phl[], pll[]; bool ev[]; int phiA[], pliA[];
      Structure(h, l, c, n, sizes[z], trend, ev, phl, pll, phiA, pliA);
      bool e0[], e3[], ech_b[], ech_s[], e2[], e5[], brkB[], brkS[], swB[], swS[];
      ArrayResize(e0, n); ArrayResize(e3, n); ArrayResize(ech_b, n); ArrayResize(ech_s, n); ArrayResize(e2, n); ArrayResize(e5, n);
      ArrayResize(brkB, n); ArrayResize(brkS, n); ArrayResize(swB, n); ArrayResize(swS, n);
      for(int t = 0; t < n; t++)
        {
         e0[t] = ev[t * 6]; e3[t] = ev[t * 6 + 3]; e2[t] = ev[t * 6 + 2]; e5[t] = ev[t * 6 + 5];
         ech_b[t] = ev[t * 6 + 1] || ev[t * 6 + 2]; ech_s[t] = ev[t * 6 + 4] || ev[t * 6 + 5];
         brkB[t] = ev[t * 6] || ev[t * 6 + 1] || ev[t * 6 + 2]; brkS[t] = ev[t * 6 + 3] || ev[t * 6 + 4] || ev[t * 6 + 5];
         double phs = t > 0 ? phl[t - 1] : NANV, pls = t > 0 ? pll[t - 1] : NANV;
         swS[t] = IsNum(phs) && h[t] > phs && c[t] < phs; swB[t] = IsNum(pls) && l[t] < pls && c[t] > pls;
        }
      double x[];
      Put("pac_" + nm + "_trend", trend[s]);
      Since(e0, n, x); Put("pac_" + nm + "_bos_b", x[s]); Since(e3, n, x); Put("pac_" + nm + "_bos_s", x[s]);
      Since(ech_b, n, x); Put("pac_" + nm + "_choch_b", x[s]); Since(ech_s, n, x); Put("pac_" + nm + "_choch_s", x[s]);
      Since(e2, n, x); Put("pac_" + nm + "_chochp_b", x[s]); Since(e5, n, x); Put("pac_" + nm + "_chochp_s", x[s]);
      double nb[], ns[], db[], ds[], ib[], is_[];
      OrderBlocks(h, l, c, atr14, brkB, brkS, phiA, pliA, n, z == 0 ? 10 : 5, nb, ns, db, ds, ib, is_);
      Put("pac_" + nm + "_ob_n_b", nb[s]); Put("pac_" + nm + "_ob_n_s", ns[s]); Put("pac_" + nm + "_ob_d_b", db[s]); Put("pac_" + nm + "_ob_d_s", ds[s]);
      Put("pac_" + nm + "_ob_in_b", ib[s]); Put("pac_" + nm + "_ob_in_s", is_[s]);
      Since(swB, n, x); Put("pac_" + nm + "_sweep_b", x[s]); Since(swS, n, x); Put("pac_" + nm + "_sweep_s", x[s]);
      if(z == 0)
        {
         double pos = 0.5;
         if(IsNum(phl[s]) && IsNum(pll[s]) && phl[s] - pll[s] > 0) pos = (c[s] - pll[s]) / (phl[s] - pll[s]);
         pos = Clip(pos, -0.5, 1.5);
         Put("pac_pd_pos", pos - 0.5); Put("pac_pd_zone", pos > 0.525 ? 1.0 : (pos < 0.475 ? -1.0 : 0.0));
        }
     }
   bool evb[], evs[]; double fnb[], fns[], fdb[], fds[], x[];
   Fvg(h, l, c, atr14, n, 20, evb, evs, fnb, fns, fdb, fds);
   Since(evb, n, x); Put("pac_fvg_b", x[s]); Since(evs, n, x); Put("pac_fvg_s", x[s]);
   Put("pac_fvg_n_b", fnb[s]); Put("pac_fvg_n_s", fns[s]); Put("pac_fvg_d_b", fdb[s]); Put("pac_fvg_d_s", fds[s]);
   bool eqh[], eql[]; double lvh[], lvl[];
   EqLevels(h, l, atr, n, 3, 0.1, eqh, eql, lvh, lvl);
   Since(eqh, n, x); Put("pac_eqh", x[s]); Since(eql, n, x); Put("pac_eql", x[s]);
   Put("pac_eqh_d", IsNum(lvh[s]) ? Clip((lvh[s] - c[s]) / atr14[s], -10, 10) : 10.0);
   Put("pac_eql_d", IsNum(lvl[s]) ? Clip((c[s] - lvl[s]) / atr14[s], -10, 10) : 10.0);
   // ---- Oscillator Matrix
   double d[], ad[], e1[], m[], e2[], a2[], hw[], sig[];
   ArrayResize(d, n); ArrayResize(ad, n);
   for(int i = 0; i < n; i++) { d[i] = i == 0 ? 0.0 : c[i] - c[i - 1]; ad[i] = MathAbs(d[i]); }
   Ema(d, n, 14, e1); Ema(e1, n, 7, m); Ema(ad, n, 14, e2); Ema(e2, n, 7, a2);
   ArrayResize(hw, n); for(int i = 0; i < n; i++) hw[i] = 50 + 50 * (a2[i] > 0 ? m[i] / a2[i] : 0.0);
   RollMean(hw, n, 3, sig);
   Put("om_hw", hw[s] - 50); Put("om_hw_sig", hw[s] - sig[s]); Put("om_hw_slope", s > 0 ? hw[s] - hw[s - 1] : 0.0);
   Put("om_hw_zone", hw[s] > 80 ? 1.0 : (hw[s] < 20 ? -1.0 : 0.0));
   bool up50[], dn50[], xu[], xd[]; ArrayResize(up50, n); ArrayResize(dn50, n); ArrayResize(xu, n); ArrayResize(xd, n);
   for(int i = 0; i < n; i++)
     {
      double hp = i == 0 ? 50.0 : hw[i - 1]; up50[i] = hw[i] > 50 && hp <= 50; dn50[i] = hw[i] < 50 && hp >= 50;
      double hp2 = i == 0 ? hw[0] : hw[i - 1], sp2 = i == 0 ? sig[0] : sig[i - 1];
      xu[i] = hw[i] > sig[i] && hp2 <= sp2 && hw[i] < 30; xd[i] = hw[i] < sig[i] && hp2 >= sp2 && hw[i] > 70;
     }
   Since(up50, n, x); Put("om_x50_b", x[s]); Since(dn50, n, x); Put("om_x50_s", x[s]);
   Since(xu, n, x); Put("om_rev_b", x[s]); Since(xd, n, x); Put("om_rev_s", x[s]);
   double tp[], pv[], nv[], ps[], ns2[], mfi[], mf[]; ArrayResize(tp, n); ArrayResize(pv, n); ArrayResize(nv, n);
   for(int i = 0; i < n; i++) tp[i] = (h[i] + l[i] + c[i]) / 3;
   for(int i = 0; i < n; i++) { double dt = i == 0 ? 0.0 : tp[i] - tp[i - 1]; double vv = MathMax(v[i], 1e-9); pv[i] = dt > 0 ? tp[i] * vv : 0; nv[i] = dt < 0 ? tp[i] * vv : 0; }
   RollSum(pv, n, 14, ps); RollSum(nv, n, 14, ns2);
   ArrayResize(mfi, n); for(int i = 0; i < n; i++) mfi[i] = 100 * ps[i] / MathMax(ps[i] + ns2[i], 1e-12);
   RollMean(mfi, n, 6, mf);
   Put("om_mf", mf[s] - 50); Put("om_mf_slope", s > 0 ? mf[s] - mf[s - 1] : 0.0);
   Put("om_conf", ((hw[s] - 50) / 50 + (mf[s] - 50) / 50) / 2);
   Put("om_conf_agree", (hw[s] > 50 && mf[s] > 50) ? 1.0 : ((hw[s] < 50 && mf[s] < 50) ? -1.0 : 0.0));
   bool dvb[], dvs[]; Divergence(h, l, hw, n, 5, dvb, dvs);
   Since(dvb, n, x); Put("om_div_b", x[s]); Since(dvs, n, x); Put("om_div_s", x[s]);
   // ---- Signals & Overlays
   double atr10[], stf[], trf[], fac[], strength[]; Rma(tr, n, 10, atr10);
   StAi(h, l, c, atr10, n, 10.0, stf, trf, fac, strength);
   Put("so_st_dir", trf[s]); Put("so_st_dist", Clip((c[s] - stf[s]) / MathMax(atr10[s], 1e-9), -20, 20));
   bool fb[], fs[]; ArrayResize(fb, n); ArrayResize(fs, n);
   for(int i = 0; i < n; i++) { double pt = i == 0 ? 1.0 : trf[i - 1], pt2 = i == 0 ? -1.0 : trf[i - 1]; fb[i] = trf[i] == 1 && pt == -1; fs[i] = trf[i] == -1 && pt2 == 1; }
   Since(fb, n, x); Put("so_st_flip_b", x[s]); Since(fs, n, x); Put("so_st_flip_s", x[s]);
   Put("so_st_strength", Clip(strength[s] * 10, 0, 10)); Put("so_st_factor", fac[s]);
   double mid[], ra[]; Ema(c, n, 20, mid); Rma(tr, n, 20, ra);
   double zz = Clip((c[s] - mid[s]) / MathMax(ra[s], 1e-9), -10, 10);
   Put("so_rb_z", zz); Put("so_rb_out", zz > 2 ? 1.0 : (zz < -2 ? -1.0 : 0.0));
   bool tu[], td[]; ArrayResize(tu, n); ArrayResize(td, n);
   for(int i = 0; i < n; i++) { tu[i] = h[i] >= mid[i] + 3 * ra[i]; td[i] = l[i] <= mid[i] - 3 * ra[i]; }
   Since(tu, n, x); Put("so_rb_touch_up", x[s]); Since(td, n, x); Put("so_rb_touch_dn", x[s]);
  }

//---- timeframe series built from completed H1 bars (H4 = 4 NY hours from 17:00, D1 = 17:00 NY day, D1 needs >= 10 bars)
bool BuildAndCompute(datetime t0utc)
  {
   MqlRates r[]; int got = CopyRates(_Symbol, PERIOD_H1, 1, InpHistBars, r);      // index 0 (current, incomplete) excluded
   if(got < InpMinBars) { gShNote = "history " + IntegerToString(got) + " < InpMinBars H1 bars"; return false; }
   double o[], h[], l[], c[], v[]; datetime tu[];
   int n = 0; ArrayResize(o, got); ArrayResize(h, got); ArrayResize(l, got); ArrayResize(c, got); ArrayResize(v, got); ArrayResize(tu, got);
   for(int i = 0; i < got; i++)
     {
      datetime u = ToUTC(r[i].time); if(u + 3600 > t0utc) continue;      // only bars complete at t0
      if(r[i].tick_volume <= 0) continue;                                  // research drops zero-volume bars
      o[n] = r[i].open; h[n] = r[i].high; l[n] = r[i].low; c[n] = r[i].close; v[n] = (double)r[i].tick_volume; tu[n] = u; n++;
     }
   if(n < InpMinBars) { gShNote = "usable bars " + IntegerToString(n); return false; }
   // H1
   gTf = 0; ComputeRaw(o, h, l, c, v, n, n - 1);
   // H4 and D1 aggregation
   datetime curKey = TradingDayKey(t0utc); int curBlk = ((NYHour(t0utc) - 17) % 24 + 24) % 24 / 4;
   for(int tf = 1; tf <= 2; tf++)
     {
      double O[], H[], L[], C[], V[]; int cnt[]; int m = 0; ArrayResize(O, n); ArrayResize(H, n); ArrayResize(L, n); ArrayResize(C, n); ArrayResize(V, n); ArrayResize(cnt, n);
      datetime pk = 0; int pb = -1; datetime lastKey = 0; int lastBlk = -1;
      for(int i = 0; i < n; i++)
        {
         datetime k = TradingDayKey(tu[i]); int b = tf == 1 ? ((NYHour(tu[i]) - 17) % 24 + 24) % 24 / 4 : 0;
         if(m == 0 || k != pk || b != pb) { O[m] = o[i]; H[m] = h[i]; L[m] = l[i]; C[m] = c[i]; V[m] = v[i]; cnt[m] = 1; m++; pk = k; pb = b; }
         else { int q = m - 1; H[q] = MathMax(H[q], h[i]); L[q] = MathMin(L[q], l[i]); C[q] = c[i]; V[q] += v[i]; cnt[q]++; }
         lastKey = k; lastBlk = b;
        }
      // drop the group still in progress at t0 (it contains the entry bar in the research data)
      if(m > 0 && lastKey == curKey && (tf == 2 || lastBlk == curBlk)) m--;
      if(tf == 2)
        {   // D1: keep days with >= 10 bars
         int w = 0; for(int q = 0; q < m; q++) if(cnt[q] >= 10) { O[w] = O[q]; H[w] = H[q]; L[w] = L[q]; C[w] = C[q]; V[w] = V[q]; w++; }
         m = w;
        }
      if(m < 300) { gShNote = "too few TF bars"; return false; }
      ArrayResize(O, m); ArrayResize(H, m); ArrayResize(L, m); ArrayResize(C, m); ArrayResize(V, m);
      gTf = tf; ComputeRaw(O, H, L, C, V, m, m - 1);
     }
   return true;
  }

//---- features in research column order (make_X), trees, reference
//@@ASSEMBLE@@
//@@MODEL@@

bool ShadowCompute(int side, datetime entryUTC)
  {
   gShOk = false; gShPred = 0; gShPct = 0; gShSize = 1.0; gShNote = "";
   MqlDateTime t; TimeToStruct(entryUTC, t); t.min = 0; t.sec = 0; datetime t0 = StructToTime(t);   // start of the entry hour (research T0)
   for(int a = 0; a < 3; a++) for(int k = 0; k < NRAW; k++) RAW[a][k] = NANV;
   if(!BuildAndCompute(t0)) { Print("Shadow: not computed - ", gShNote); return false; }
   ArrayResize(gFeat, NFEAT); Assemble((double)side, gFeat);
   for(int k = 0; k < NFEAT; k++) if(!IsNum(gFeat[k])) { gShNote = "NaN feature " + IntegerToString(k); Print("Shadow: ", gShNote); return false; }
   gShPred = PredictRF(gFeat);
   int cnt = 0; for(int k = 0; k < NREF; k++) if(REF[k] <= gShPred) cnt++;
   gShPct = (double)cnt / NREF; gShSize = 0.5 + gShPct; gShOk = true; gShNote = "ok";
   PrintFormat("Shadow: pred %.6f pct %.3f -> would size x%.2f (NOT applied)", gShPred, gShPct, gShSize);
   return true;
  }

//==================================================================== logging
void LogSignal(datetime entT)
  {
   int hd = FileOpen(InpSigName, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, ',');
   if(hd == INVALID_HANDLE) return;
   if(FileSize(hd) == 0)
     {
      string hdr = "day_ny,side,entry_time_utc,entry_price,level,shadow_ok,shadow_pred,shadow_pct,shadow_size,note";
      for(int k = 0; k < NFEAT; k++) hdr += "," + FEATN[k];
      FileWriteString(hd, hdr + "\r\n");
     }
   FileSeek(hd, 0, SEEK_END);
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   string row = TimeToString(dayKey, TIME_DATE) + "," + (gSide == 1 ? "BUY" : "SELL") + "," + TimeToString(ToUTC(entT), TIME_DATE | TIME_SECONDS) + ","
                + DoubleToString(gEnt, dg) + "," + DoubleToString(gLvl, dg) + "," + (gShOk ? "1" : "0") + "," + DoubleToString(gShPred, 8) + ","
                + DoubleToString(gShPct, 4) + "," + DoubleToString(gShSize, 4) + "," + gShNote;
   for(int k = 0; k < NFEAT; k++) row += "," + (gShOk ? DoubleToString(gFeat[k], 8) : "");
   FileWriteString(hd, row + "\r\n"); FileClose(hd);
  }

void DumpBars()
  {
   static datetime lastDump = 0; if(!InpDumpBars || dayKey == lastDump) return; lastDump = dayKey;
   MqlRates r[]; int got = CopyRates(_Symbol, PERIOD_H1, 1, InpHistBars + 40000, r); if(got <= 0) return;   // long enough to re-check old trades
   int hd = FileOpen(InpBarsName, FILE_WRITE | FILE_CSV | FILE_ANSI, ','); if(hd == INVALID_HANDLE) return;
   FileWriteString(hd, "time_utc,o,h,l,c,v\r\n");
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   for(int i = 0; i < got; i++)
      FileWriteString(hd, TimeToString(ToUTC(r[i].time), TIME_DATE | TIME_MINUTES) + "," + DoubleToString(r[i].open, dg) + "," + DoubleToString(r[i].high, dg) + ","
                      + DoubleToString(r[i].low, dg) + "," + DoubleToString(r[i].close, dg) + "," + IntegerToString(r[i].tick_volume) + "\r\n");
   FileClose(hd);
  }

//==================================================================== trading (identical to GoldWilliams.mq5 v1.00)
bool FindPos(ulong &tk)
  {
   for(int k = PositionsTotal() - 1; k >= 0; k--)
     {
      ulong t = PositionGetTicket(k); if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == InpMagic) { tk = t; return true; }
     }
   return false;
  }
bool SafeClose(ulong tk)
  {
   bool ok = trade.PositionClose(tk); uint rc = trade.ResultRetcode();
   if(ok && (rc == TRADE_RETCODE_DONE || rc == TRADE_RETCODE_PLACED || rc == TRADE_RETCODE_DONE_PARTIAL)) return true;
   if(!PositionSelectByTicket(tk)) return true;
   int np = ArraySize(pendClose); for(int k = 0; k < np; k++) if(pendClose[k] == tk) return false;
   ArrayResize(pendClose, np + 1); pendClose[np] = tk; Print("Close rejected (", trade.ResultRetcodeDescription(), "), retry every 30 s"); return false;
  }
void RetryPendingCloses()
  {
   static datetime last = 0; if(ArraySize(pendClose) == 0 || TimeCurrent() - last < 30) return; last = TimeCurrent();
   for(int k = ArraySize(pendClose) - 1; k >= 0; k--)
     {
      ulong tk = pendClose[k]; bool gone = !PositionSelectByTicket(tk);
      if(!gone) { bool ok = trade.PositionClose(tk); uint rc = trade.ResultRetcode(); gone = ok && (rc == TRADE_RETCODE_DONE || rc == TRADE_RETCODE_PLACED || rc == TRADE_RETCODE_DONE_PARTIAL); }
      if(gone) { for(int m = k; m < ArraySize(pendClose) - 1; m++) pendClose[m] = pendClose[m + 1]; ArrayResize(pendClose, ArraySize(pendClose) - 1); }
     }
  }
bool ComputeLevels(datetime nowUTC)
  {
   MqlRates r[]; int got = CopyRates(_Symbol, PERIOD_H1, 0, 72, r);
   if(got < 30) return false;
   datetime today = TradingDayKey(nowUTC);
   double ph = -1, pl = 1e18, op = 0; datetime prevKey = 0; bool haveOpen = false;
   for(int k = got - 1; k >= 0; k--)
     {
      datetime key = TradingDayKey(ToUTC(r[k].time));
      if(key == today) { op = r[k].open; haveOpen = true; continue; }
      if(prevKey == 0) prevKey = key;
      if(key != prevKey) break;
      ph = MathMax(ph, r[k].high); pl = MathMin(pl, r[k].low);
     }
   if(!haveOpen || ph <= 0 || pl >= 1e17) return false;
   dOpen = op; prevRange = ph - pl; buyLvl = op + K_RANGE * prevRange; sellLvl = op - K_RANGE * prevRange;
   return prevRange > 0;
  }
double LotFor(double price)
  {
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP), mn = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN), mx = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lot = InpFixedLot;
   if(lot <= 0) lot = AccountInfoDouble(ACCOUNT_EQUITY) * InpLev / (price * SymbolInfoDouble(_Symbol, SYMBOL_TRADE_CONTRACT_SIZE));
   if(step <= 0) step = 0.01; lot = MathFloor(lot / step + 1e-9) * step;
   if(lot < mn) return 0.0; if(lot > mx) lot = mx; return NormalizeDouble(lot, 2);
  }

void LogTrade(datetime xT, double xPx, string why, double comm, double swap, double profit)
  {
   int hd = FileOpen(InpCsvName, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, ',');
   if(hd == INVALID_HANDLE) return;
   if(FileSize(hd) == 0) FileWrite(hd, "day_ny", "side", "level", "entry_time_utc", "entry_price", "slippage", "spread", "exit_time_utc", "exit_price", "reason", "volume",
                                      "commission", "swap", "profit", "signal_bp", "net_bp", "shadow_ok", "shadow_pred", "shadow_pct", "shadow_size", "shadow_volume");
   FileSeek(hd, 0, SEEK_END);
   double contract = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_CONTRACT_SIZE), notional = gVol * contract * gEnt;
   double sigbp = gLvl > 0 ? gSide * (xPx - gLvl) / gLvl * 1e4 : 0, netbp = notional > 0 ? (profit + comm + swap) / notional * 1e4 : 0;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   FileWrite(hd, TimeToString(dayKey, TIME_DATE), gSide == 1 ? "BUY" : "SELL", DoubleToString(gLvl, dg), TimeToString(ToUTC(gEntT), TIME_DATE | TIME_SECONDS),
             DoubleToString(gEnt, dg), DoubleToString(gSide * (gEnt - gLvl), dg), DoubleToString(gSpr, dg), TimeToString(ToUTC(xT), TIME_DATE | TIME_SECONDS),
             DoubleToString(xPx, dg), why, DoubleToString(gVol, 2), DoubleToString(comm, 2), DoubleToString(swap, 2), DoubleToString(profit, 2),
             DoubleToString(sigbp, 3), DoubleToString(netbp, 3), gShOk ? "1" : "0", DoubleToString(gShPred, 8), DoubleToString(gShPct, 4),
             DoubleToString(gShSize, 4), DoubleToString(gVol * gShSize, 4));
   FileClose(hd);
  }

void FinishIfClosed()
  {
   if(gTicket == 0 || PositionSelectByTicket(gTicket)) return;
   double comm = 0, swap = 0, profit = 0, xPx = 0; datetime xT = TimeCurrent(); string why = "CLOSE";
   if(HistorySelectByPosition(gPosId))
      for(int k = 0; k < HistoryDealsTotal(); k++)
        {
         ulong d = HistoryDealGetTicket(k); if(d == 0) continue;
         comm += HistoryDealGetDouble(d, DEAL_COMMISSION); swap += HistoryDealGetDouble(d, DEAL_SWAP); profit += HistoryDealGetDouble(d, DEAL_PROFIT);
         long e = HistoryDealGetInteger(d, DEAL_ENTRY);
         if(e == DEAL_ENTRY_OUT || e == DEAL_ENTRY_OUT_BY) { xPx = HistoryDealGetDouble(d, DEAL_PRICE); xT = (datetime)HistoryDealGetInteger(d, DEAL_TIME); if(HistoryDealGetInteger(d, DEAL_REASON) == DEAL_REASON_SL) why = "SL"; }
        }
   static int waits = 0; if(xPx <= 0 && waits < 30) { waits++; return; } waits = 0;
   if(gStale && why == "CLOSE") why = "STALE_CLOSE"; gStale = false;
   LogTrade(xT, xPx, why, comm, swap, profit); gTicket = 0; gPosId = 0; gSide = 0;
  }

void OnTickLogic()
  {
   RetryPendingCloses(); FinishIfClosed();
   datetime nowUTC = ToUTC(TimeCurrent());
   datetime key = TradingDayKey(nowUTC);
   if(key != dayKey) { dayKey = key; tradedToday = false; if(!ComputeLevels(nowUTC)) { dOpen = 0; } DumpBars(); }
   int nm = NYMinute(nowUTC);
   ulong tk;
   if(FindPos(tk))
     {
      // v1.01 SAFETY: a Williams trade never lives past its trading day. If the 16:58-17:00 NY window got no tick/timer
      // (e.g. broker daily break), close at the first chance of the next day instead of holding forever.
      datetime posKey = TradingDayKey(ToUTC((datetime)PositionGetInteger(POSITION_TIME)));
      if(posKey != dayKey) { gStale = true; SafeClose(tk); return; }
      if(nm >= EXIT_NY_MIN && nm < 17 * 60) SafeClose(tk);
      return;
     }
   if(tradedToday || dOpen <= 0 || (nm >= EXIT_NY_MIN && nm < 17 * 60)) return;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID), ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   int side = bid >= buyLvl ? 1 : (bid <= sellLvl ? -1 : 0);
   if(side == 0) return;
   tradedToday = true;
   if(InpMaxSpread > 0 && ask - bid > InpMaxSpread) { Print("Williams: skipped, spread ", ask - bid); return; }
   double px = side == 1 ? ask : bid, lot = LotFor(px);
   if(lot <= 0) { Print("Williams: lot below minimum"); return; }
   trade.SetExpertMagicNumber(InpMagic); trade.SetDeviationInPoints(InpDeviation);
   bool ok = side == 1 ? trade.Buy(lot, _Symbol, 0, 0, 0, "Williams#112S") : trade.Sell(lot, _Symbol, 0, 0, 0, "Williams#112S");
   if(!ok) { Print("Williams order failed: ", trade.ResultRetcodeDescription()); return; }
   if(FindPos(tk) && PositionSelectByTicket(tk))
     {
      gTicket = tk; gPosId = PositionGetInteger(POSITION_IDENTIFIER); gSide = side; gLvl = side == 1 ? buyLvl : sellLvl;
      gEnt = PositionGetDouble(POSITION_PRICE_OPEN); gVol = PositionGetDouble(POSITION_VOLUME); gEntT = (datetime)PositionGetInteger(POSITION_TIME); gSpr = ask - bid;
      PrintFormat("Williams %s %.2f lots @ %.2f (level %.2f, open %.2f, prev range %.2f)", side == 1 ? "BUY" : "SELL", gVol, gEnt, gLvl, dOpen, prevRange);
      // SHADOW: computed AFTER the order is filled, so it can never delay or change the trade
      gShOk = false; gShSize = 1.0;
      if(InpShadow) { ShadowCompute(side, ToUTC(gEntT)); LogSignal(gEntT); }
     }
  }

int OnInit()
  {
   NANV = MathSqrt(-1.0);
   PrintFormat("GoldWilliams_Shadow #112 on %s | contract %.2f | magic %I64d | shadow %s (%d trees, %d features)", _Symbol,
               SymbolInfoDouble(_Symbol, SYMBOL_TRADE_CONTRACT_SIZE), InpMagic, InpShadow ? "ON" : "OFF", NTREES, NFEAT);
   ulong tk; if(FindPos(tk) && PositionSelectByTicket(tk)) { gTicket = tk; gPosId = PositionGetInteger(POSITION_IDENTIFIER); gSide = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1; gEnt = PositionGetDouble(POSITION_PRICE_OPEN); gVol = PositionGetDouble(POSITION_VOLUME); gEntT = (datetime)PositionGetInteger(POSITION_TIME); tradedToday = true; }
   EventSetTimer(10); return INIT_SUCCEEDED;
  }
void OnDeinit(const int reason) { EventKillTimer(); }
void OnTimer() { OnTickLogic(); }
void OnTick() { OnTickLogic(); }
//+------------------------------------------------------------------+
