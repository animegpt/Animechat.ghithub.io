//+------------------------------------------------------------------+
//| GoldComboShadow.mqh  (GENERATED by code/build_combo_shadow.py)   |
//| SHADOW for GoldComboAI: at every Sonic / Overnight entry it      |
//| computes the 206 three-indicator features and the frozen #159    |
//| per-strategy RF model and LOGS the size it would have used       |
//| (0.5-1.5). It never sends, closes or resizes any order.          |
//| Research verdict #159: "probable, not proven" (DSR fail).        |
//+------------------------------------------------------------------+
input group "Shadow AI (log only, never trades)"
input bool   InpGSShadow     = true;     // Log the three-indicator RF opinion for each Sonic / Overnight trade
input int    GS_InpHistBars  = 80000;    // H1 bars for the features. Overnight model needs ~80000 (13 y) to match research; Sonic is stable from 20000
input int    GS_InpMinBars   = 15000;    // min usable bars (Strategy Tester parity run: e.g. 4000)
input bool   InpGSDumpBars   = true;     // dump H1 bars once per day (Python parity check)
string GS_SigFile = "GoldComboShadow_signals.csv", GS_TrdFile = "GoldComboShadow_trades.csv", GS_BarFile = "GoldComboShadow_bars.csv";
double GS_NANV = 0; bool GS_inited = false; string GS_gShNote = "";
datetime GS_ToUTC(datetime s) { return (datetime)((long)s - (long)InpServerUTC * 3600); }
datetime GS_NthSundayUTC(int y, int mon, int nth, int hUTC)
  {
   MqlDateTime d; ZeroMemory(d); d.year = y; d.mon = mon; d.day = 1;
   datetime f = StructToTime(d); MqlDateTime s; TimeToStruct(f, s);
   int add = (7 - s.day_of_week) % 7;
   return (datetime)((long)f + (long)(add + 7 * (nth - 1)) * 86400 + (long)hUTC * 3600);
  }
int GS_NYOffset(datetime utc)
  {
   MqlDateTime t; TimeToStruct(utc, t);
   return (utc >= GS_NthSundayUTC(t.year, 3, 2, 7) && utc < GS_NthSundayUTC(t.year, 11, 1, 6)) ? -4 : -5;
  }
datetime GS_ToNY(datetime utc) { return (datetime)((long)utc + (long)GS_NYOffset(utc) * 3600); }
datetime GS_TradingDayKey(datetime utc)
  {
   datetime ny = GS_ToNY(utc); MqlDateTime t; TimeToStruct((datetime)((long)ny + 7 * 3600), t);
   t.hour = 0; t.min = 0; t.sec = 0; return StructToTime(t);
  }
int GS_NYMinute(datetime utc) { MqlDateTime t; TimeToStruct(GS_ToNY(utc), t); return t.hour * 60 + t.min; }
int GS_NYHour(datetime utc) { MqlDateTime t; TimeToStruct(GS_ToNY(utc), t); return t.hour; }

//==================================================================== indicator port of code/ind3.py
#define GS_BIGV 999.0
bool GS_IsNum(double x) { return MathIsValidNumber(x); }
double GS_Clip(double x, double a, double b) { return x < a ? a : (x > b ? b : x); }
double GS_Sgn(double x) { return x > 0 ? 1.0 : (x < 0 ? -1.0 : 0.0); }

void GS_Rma(const double &x[], int n, int p, double &out[])
  { ArrayResize(out, n); double a = 1.0 / p, s = x[0]; for(int i = 0; i < n; i++) { s = (i == 0) ? x[0] : s + a * (x[i] - s); out[i] = s; } }
void GS_Ema(const double &x[], int n, int p, double &out[])
  { ArrayResize(out, n); double a = 2.0 / (p + 1), s = x[0]; for(int i = 0; i < n; i++) { s = (i == 0) ? x[0] : s + a * (x[i] - s); out[i] = s; } }
void GS_TrueRange(const double &h[], const double &l[], const double &c[], int n, double &out[])
  {
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) { double pc = i == 0 ? c[0] : c[i - 1]; out[i] = MathMax(h[i] - l[i], MathMax(MathAbs(h[i] - pc), MathAbs(l[i] - pc))); }
  }
void GS_Since(const bool &ev[], int n, double &out[])
  { ArrayResize(out, n); int last = -1; for(int i = 0; i < n; i++) { if(ev[i]) last = i; out[i] = last < 0 ? GS_BIGV : (double)(i - last); } }
void GS_RollMean(const double &x[], int n, int p, double &out[])     // pandas rolling(p, min_periods=1).mean()
  {
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) { int a = MathMax(0, i - p + 1); double s = 0; for(int k = a; k <= i; k++) s += x[k]; out[i] = s / (i - a + 1); }
  }
void GS_RollSum(const double &x[], int n, int p, double &out[])
  {
   ArrayResize(out, n);
   for(int i = 0; i < n; i++) { int a = MathMax(0, i - p + 1); double s = 0; for(int k = a; k <= i; k++) s += x[k]; out[i] = s; }
  }

// ---- PAC structure (LuxAlgo leg pivots + close breaks). ev[t*6+k]: 0 bos_b,1 choch_b,2 chochp_b,3 bos_s,4 choch_s,5 chochp_s
void GS_Structure(const double &h[], const double &l[], const double &c[], int n, int size,
               double &trend[], bool &ev[], double &phl[], double &pll[], int &phiA[], int &pliA[])
  {
   ArrayResize(trend, n); ArrayResize(ev, n * 6); ArrayResize(phl, n); ArrayResize(pll, n); ArrayResize(phiA, n); ArrayResize(pliA, n);
   for(int i = 0; i < n; i++) { trend[i] = 0; phl[i] = GS_NANV; pll[i] = GS_NANV; phiA[i] = -1; pliA[i] = -1; }
   for(int i = 0; i < n * 6; i++) ev[i] = false;
   int leg = 0; double ph = GS_NANV, pl = GS_NANV; bool phx = true, plx = true; int tr = 0;
   double phPrev = GS_NANV, plPrev = GS_NANV; int phi = -1, pli = -1;
   for(int t = size; t < n; t++)
     {
      double hh = h[t - size + 1], ll = l[t - size + 1];
      for(int k = t - size + 1; k <= t; k++) { if(h[k] > hh) hh = h[k]; if(l[k] < ll) ll = l[k]; }
      bool newH = h[t - size] > hh, newL = l[t - size] < ll;
      int prev = leg;
      if(newH) leg = 0; else if(newL) leg = 1;
      if(leg != prev)
        {
         if(leg == 1) { plPrev = pl; pl = l[t - size]; plx = false; pli = t - size; }
         else         { phPrev = ph; ph = h[t - size]; phx = false; phi = t - size; }
        }
      if(GS_IsNum(ph) && !phx && c[t] > ph)
        {
         phx = true;
         if(tr == -1) { bool plus = GS_IsNum(plPrev) && pl > plPrev; if(plus) ev[t * 6 + 2] = true; else ev[t * 6 + 1] = true; }
         else ev[t * 6 + 0] = true;
         tr = 1;
        }
      if(GS_IsNum(pl) && !plx && c[t] < pl)
        {
         plx = true;
         if(tr == 1) { bool plus = GS_IsNum(phPrev) && ph < phPrev; if(plus) ev[t * 6 + 5] = true; else ev[t * 6 + 4] = true; }
         else ev[t * 6 + 3] = true;
         tr = -1;
        }
      trend[t] = tr; phl[t] = ph; pll[t] = pl; phiA[t] = phi; pliA[t] = pli;
     }
  }

void GS_OrderBlocks(const double &h[], const double &l[], const double &c[], const double &atr[], const bool &brkB[], const bool &brkS[],
                 const int &phiA[], const int &pliA[], int n, int maxKeep,
                 double &nb[], double &ns[], double &db[], double &ds[], double &ib[], double &is_[])
  {
   double bt[], bb[], st_[], sb[]; ArrayResize(bt, maxKeep); ArrayResize(bb, maxKeep); ArrayResize(st_, maxKeep); ArrayResize(sb, maxKeep);
   for(int q = 0; q < maxKeep; q++) { bt[q] = GS_NANV; bb[q] = GS_NANV; st_[q] = GS_NANV; sb[q] = GS_NANV; }
   ArrayResize(nb, n); ArrayResize(ns, n); ArrayResize(db, n); ArrayResize(ds, n); ArrayResize(ib, n); ArrayResize(is_, n);
   int kb = 0, ks = 0;
   for(int t = 0; t < n; t++)
     {
      nb[t] = 0; ns[t] = 0; db[t] = 10.0; ds[t] = 10.0; ib[t] = 0; is_[t] = 0;
      if(brkB[t] && phiA[t] >= 0 && t - phiA[t] >= 2)
        { int s = phiA[t], j = s; for(int k = s; k < t; k++) if(l[k] < l[j]) j = k; bt[kb % maxKeep] = h[j]; bb[kb % maxKeep] = l[j]; kb++; }
      if(brkS[t] && pliA[t] >= 0 && t - pliA[t] >= 2)
        { int s = pliA[t], j = s; for(int k = s; k < t; k++) if(h[k] > h[j]) j = k; st_[ks % maxKeep] = h[j]; sb[ks % maxKeep] = l[j]; ks++; }
      double a = atr[t] > 0 ? atr[t] : 1e-9; int cb = 0, cs = 0;
      for(int q = 0; q < maxKeep; q++)
        {
         if(GS_IsNum(bb[q]))
           {
            if(c[t] < bb[q]) { bb[q] = GS_NANV; bt[q] = GS_NANV; }
            else { cb++; double d = (c[t] - bt[q]) / a; if(d < 0) { d = 0.0; ib[t] = 1; } if(d < db[t]) db[t] = d; }
           }
         if(GS_IsNum(st_[q]))
           {
            if(c[t] > st_[q]) { st_[q] = GS_NANV; sb[q] = GS_NANV; }
            else { cs++; double d = (sb[q] - c[t]) / a; if(d < 0) { d = 0.0; is_[t] = 1; } if(d < ds[t]) ds[t] = d; }
           }
        }
      nb[t] = cb; ns[t] = cs;
     }
  }

void GS_Fvg(const double &h[], const double &l[], const double &c[], const double &atr[], int n, int maxKeep,
         bool &evb[], bool &evs[], double &nb[], double &ns[], double &db[], double &ds[])
  {
   double zb[], zbt[], zs[], zsb[]; ArrayResize(zb, maxKeep); ArrayResize(zbt, maxKeep); ArrayResize(zs, maxKeep); ArrayResize(zsb, maxKeep);
   for(int q = 0; q < maxKeep; q++) { zb[q] = GS_NANV; zbt[q] = GS_NANV; zs[q] = GS_NANV; zsb[q] = GS_NANV; }
   ArrayResize(evb, n); ArrayResize(evs, n); ArrayResize(nb, n); ArrayResize(ns, n); ArrayResize(db, n); ArrayResize(ds, n);
   for(int t = 0; t < n; t++) { evb[t] = false; evs[t] = false; nb[t] = 0; ns[t] = 0; db[t] = 10.0; ds[t] = 10.0; }
   int kb = 0, ks = 0;
   for(int t = 2; t < n; t++)
     {
      if(l[t] > h[t - 2] && c[t - 1] > h[t - 2]) { evb[t] = true; zb[kb % maxKeep] = h[t - 2]; zbt[kb % maxKeep] = l[t]; kb++; }
      if(h[t] < l[t - 2] && c[t - 1] < l[t - 2]) { evs[t] = true; zs[ks % maxKeep] = l[t - 2]; zsb[ks % maxKeep] = h[t]; ks++; }
      double a = atr[t] > 0 ? atr[t] : 1e-9; int cb = 0, cs = 0;
      for(int q = 0; q < maxKeep; q++)
        {
         if(GS_IsNum(zb[q])) { if(l[t] <= zb[q]) zb[q] = GS_NANV; else { cb++; double d = (c[t] - zbt[q]) / a; if(d < 0) d = 0.0; if(d < db[t]) db[t] = d; } }
         if(GS_IsNum(zs[q])) { if(h[t] >= zs[q]) zs[q] = GS_NANV; else { cs++; double d = (zsb[q] - c[t]) / a; if(d < 0) d = 0.0; if(d < ds[t]) ds[t] = d; } }
        }
      nb[t] = cb; ns[t] = cs;
     }
  }

void GS_EqLevels(const double &h[], const double &l[], const double &atr[], int n, int size, double thr,
              bool &eqh[], bool &eql[], double &lvh[], double &lvl[])
  {
   ArrayResize(eqh, n); ArrayResize(eql, n); ArrayResize(lvh, n); ArrayResize(lvl, n);
   for(int i = 0; i < n; i++) { eqh[i] = false; eql[i] = false; lvh[i] = GS_NANV; lvl[i] = GS_NANV; }
   double lastph = GS_NANV, lastpl = GS_NANV, curh = GS_NANV, curl = GS_NANV;
   for(int t = 2 * size; t < n; t++)
     {
      int p = t - size; bool isph = true, ispl = true;
      for(int k = p - size; k <= p + size; k++) { if(k == p) continue; if(h[k] >= h[p]) isph = false; if(l[k] <= l[p]) ispl = false; }
      if(isph) { if(GS_IsNum(lastph) && MathAbs(h[p] - lastph) < thr * atr[t]) { eqh[t] = true; curh = MathMax(h[p], lastph); } lastph = h[p]; }
      if(ispl) { if(GS_IsNum(lastpl) && MathAbs(l[p] - lastpl) < thr * atr[t]) { eql[t] = true; curl = MathMin(l[p], lastpl); } lastpl = l[p]; }
      lvh[t] = curh; lvl[t] = curl;
     }
  }

void GS_Divergence(const double &h[], const double &l[], const double &w[], int n, int size, bool &bull[], bool &bear[])
  {
   ArrayResize(bull, n); ArrayResize(bear, n); for(int i = 0; i < n; i++) { bull[i] = false; bear[i] = false; }
   double lph = GS_NANV, lphw = GS_NANV, lpl = GS_NANV, lplw = GS_NANV;
   for(int t = 2 * size; t < n; t++)
     {
      int p = t - size; bool isph = true, ispl = true;
      for(int k = p - size; k <= p + size; k++) { if(k == p) continue; if(h[k] >= h[p]) isph = false; if(l[k] <= l[p]) ispl = false; }
      if(isph) { if(GS_IsNum(lph) && h[p] > lph && w[p] < lphw) bear[t] = true; lph = h[p]; lphw = w[p]; }
      if(ispl) { if(GS_IsNum(lpl) && l[p] < lpl && w[p] > lplw) bull[t] = true; lpl = l[p]; lplw = w[p]; }
     }
  }

void GS_StOne(const double &hl2[], const double &c[], const double &atr[], int n, double f, double &st[])
  {
   ArrayResize(st, n); double up = hl2[0] - f * atr[0], dn = hl2[0] + f * atr[0]; int t_ = 1;
   for(int i = 0; i < n; i++)
     {
      double u = hl2[i] - f * atr[i], d = hl2[i] + f * atr[i];
      if(i > 0)
        {
         u = c[i - 1] > up ? MathMax(u, up) : u; d = c[i - 1] < dn ? MathMin(d, dn) : d;
         if(t_ == 1 && c[i] < up) t_ = -1; else if(t_ == -1 && c[i] > dn) t_ = 1;
        }
      up = u; dn = d; st[i] = t_ == 1 ? up : dn;
     }
  }

void GS_StAi(const double &h[], const double &l[], const double &c[], const double &atr[], int n, double perfAlpha,
          double &stf[], double &trf[], double &fac[], double &strength[])
  {
   int K = 9; double factors[9]; for(int k = 0; k < K; k++) factors[k] = 1.0 + 0.5 * k;
   double hl2[]; ArrayResize(hl2, n); for(int i = 0; i < n; i++) hl2[i] = (h[i] + l[i]) / 2;
   double sts[]; ArrayResize(sts, K * n);
   for(int k = 0; k < K; k++) { double s[]; GS_StOne(hl2, c, atr, n, factors[k], s); for(int i = 0; i < n; i++) sts[k * n + i] = s[i]; }
   double perf[9]; ArrayInitialize(perf, 0.0); double a = 2.0 / (perfAlpha + 1), den = 0.0;
   ArrayResize(stf, n); ArrayResize(trf, n); ArrayResize(fac, n); ArrayResize(strength, n);
   double up = hl2[0] - 3 * atr[0], dn = hl2[0] + 3 * atr[0]; int t_ = 1; double f = 3.0;
   for(int i = 0; i < n; i++)
     {
      strength[i] = 0;
      if(i > 0)
        {
         double dc = c[i] - c[i - 1];
         for(int k = 0; k < K; k++) perf[k] += a * (dc * GS_Sgn(c[i - 1] - sts[k * n + i - 1]) - perf[k]);
         den += a * (MathAbs(dc) - den);
         double srt[9]; for(int k = 0; k < K; k++) srt[k] = perf[k]; ArraySort(srt);
         double cen[3]; cen[0] = srt[(int)(0.25 * (K - 1))]; cen[1] = srt[(int)(0.5 * (K - 1))]; cen[2] = srt[(int)(0.75 * (K - 1))];
         int lab[9];
         for(int it = 0; it < 20; it++)
           {
            for(int k = 0; k < K; k++)
              { int b = 0; double bd = MathAbs(perf[k] - cen[0]); for(int q = 1; q < 3; q++) { double dd = MathAbs(perf[k] - cen[q]); if(dd < bd) { bd = dd; b = q; } } lab[k] = b; }
            double newc[3]; for(int q = 0; q < 3; q++) newc[q] = cen[q];
            for(int q = 0; q < 3; q++) { double s = 0; int m = 0; for(int k = 0; k < K; k++) if(lab[k] == q) { s += perf[k]; m++; } if(m > 0) newc[q] = s / m; }
            bool conv = true; for(int q = 0; q < 3; q++) if(MathAbs(newc[q] - cen[q]) >= 1e-12) conv = false;
            if(conv) break;
            for(int q = 0; q < 3; q++) cen[q] = newc[q];
           }
         int best = 0; for(int q = 1; q < 3; q++) if(cen[q] > cen[best]) best = q;
         double s = 0; int m = 0; for(int k = 0; k < K; k++) if(lab[k] == best) { s += factors[k]; m++; }
         if(m > 0) f = s / m;
         strength[i] = den > 0 ? MathMax(cen[best], 0.0) / den : 0.0;
        }
      double u = hl2[i] - f * atr[i], d = hl2[i] + f * atr[i];
      if(i > 0)
        {
         u = c[i - 1] > up ? MathMax(u, up) : u; d = c[i - 1] < dn ? MathMin(d, dn) : d;
         if(t_ == 1 && c[i] < up) t_ = -1; else if(t_ == -1 && c[i] > dn) t_ = 1;
        }
      up = u; dn = d; stf[i] = t_ == 1 ? up : dn; trf[i] = t_; fac[i] = f;
     }
  }

//---- raw value store (bull-positive values of features149 raw columns) at the selected bar
#define GS_NRAW 66
string GS_RAWN[GS_NRAW] = {"pac_sw_trend", "pac_in_trend", "pac_pd_pos", "pac_pd_zone", "om_hw", "om_hw_sig", "om_hw_slope", "om_hw_zone", "om_mf", "om_mf_slope", "om_conf", "om_conf_agree", "so_st_dir", "so_st_dist", "so_rb_z", "so_rb_out", "so_st_strength", "so_st_factor", "pac_sw_bos_b", "pac_sw_bos_s", "pac_sw_choch_b", "pac_sw_choch_s", "pac_sw_chochp_b", "pac_sw_chochp_s", "pac_sw_sweep_b", "pac_sw_sweep_s", "pac_sw_ob_n_b", "pac_sw_ob_n_s", "pac_sw_ob_d_b", "pac_sw_ob_d_s", "pac_sw_ob_in_b", "pac_sw_ob_in_s", "pac_in_bos_b", "pac_in_bos_s", "pac_in_choch_b", "pac_in_choch_s", "pac_in_chochp_b", "pac_in_chochp_s", "pac_in_sweep_b", "pac_in_sweep_s", "pac_in_ob_n_b", "pac_in_ob_n_s", "pac_in_ob_d_b", "pac_in_ob_d_s", "pac_in_ob_in_b", "pac_in_ob_in_s", "pac_fvg_b", "pac_fvg_s", "pac_fvg_n_b", "pac_fvg_n_s", "pac_fvg_d_b", "pac_fvg_d_s", "pac_eqh", "pac_eql", "pac_eqh_d", "pac_eql_d", "om_x50_b", "om_x50_s", "om_rev_b", "om_rev_s", "om_div_b", "om_div_s", "so_st_flip_b", "so_st_flip_s", "so_rb_touch_dn", "so_rb_touch_up"};
double GS_RAW[3][GS_NRAW];
int GS_gTf = 0;
void GS_Put(string name, double v)
  {
   for(int k = 0; k < GS_NRAW; k++) if(GS_RAWN[k] == name) { GS_RAW[GS_gTf][k] = v; return; }
  }

// compute every indicator over the series and store the values at bar `s`
void GS_ComputeRaw(const double &o[], const double &h[], const double &l[], const double &c[], const double &v[], int n, int s)
  {
   double tr[], atr[], atr14[]; GS_TrueRange(h, l, c, n, tr); GS_Rma(tr, n, 200, atr); GS_Rma(tr, n, 14, atr14);
   string nms[2] = {"sw", "in"}; int sizes[2] = {50, 5};
   for(int z = 0; z < 2; z++)
     {
      string nm = nms[z];
      double trend[], phl[], pll[]; bool ev[]; int phiA[], pliA[];
      GS_Structure(h, l, c, n, sizes[z], trend, ev, phl, pll, phiA, pliA);
      bool e0[], e3[], ech_b[], ech_s[], e2[], e5[], brkB[], brkS[], swB[], swS[];
      ArrayResize(e0, n); ArrayResize(e3, n); ArrayResize(ech_b, n); ArrayResize(ech_s, n); ArrayResize(e2, n); ArrayResize(e5, n);
      ArrayResize(brkB, n); ArrayResize(brkS, n); ArrayResize(swB, n); ArrayResize(swS, n);
      for(int t = 0; t < n; t++)
        {
         e0[t] = ev[t * 6]; e3[t] = ev[t * 6 + 3]; e2[t] = ev[t * 6 + 2]; e5[t] = ev[t * 6 + 5];
         ech_b[t] = ev[t * 6 + 1] || ev[t * 6 + 2]; ech_s[t] = ev[t * 6 + 4] || ev[t * 6 + 5];
         brkB[t] = ev[t * 6] || ev[t * 6 + 1] || ev[t * 6 + 2]; brkS[t] = ev[t * 6 + 3] || ev[t * 6 + 4] || ev[t * 6 + 5];
         double phs = t > 0 ? phl[t - 1] : GS_NANV, pls = t > 0 ? pll[t - 1] : GS_NANV;
         swS[t] = GS_IsNum(phs) && h[t] > phs && c[t] < phs; swB[t] = GS_IsNum(pls) && l[t] < pls && c[t] > pls;
        }
      double x[];
      GS_Put("pac_" + nm + "_trend", trend[s]);
      GS_Since(e0, n, x); GS_Put("pac_" + nm + "_bos_b", x[s]); GS_Since(e3, n, x); GS_Put("pac_" + nm + "_bos_s", x[s]);
      GS_Since(ech_b, n, x); GS_Put("pac_" + nm + "_choch_b", x[s]); GS_Since(ech_s, n, x); GS_Put("pac_" + nm + "_choch_s", x[s]);
      GS_Since(e2, n, x); GS_Put("pac_" + nm + "_chochp_b", x[s]); GS_Since(e5, n, x); GS_Put("pac_" + nm + "_chochp_s", x[s]);
      double nb[], ns[], db[], ds[], ib[], is_[];
      GS_OrderBlocks(h, l, c, atr14, brkB, brkS, phiA, pliA, n, z == 0 ? 10 : 5, nb, ns, db, ds, ib, is_);
      GS_Put("pac_" + nm + "_ob_n_b", nb[s]); GS_Put("pac_" + nm + "_ob_n_s", ns[s]); GS_Put("pac_" + nm + "_ob_d_b", db[s]); GS_Put("pac_" + nm + "_ob_d_s", ds[s]);
      GS_Put("pac_" + nm + "_ob_in_b", ib[s]); GS_Put("pac_" + nm + "_ob_in_s", is_[s]);
      GS_Since(swB, n, x); GS_Put("pac_" + nm + "_sweep_b", x[s]); GS_Since(swS, n, x); GS_Put("pac_" + nm + "_sweep_s", x[s]);
      if(z == 0)
        {
         double pos = 0.5;
         if(GS_IsNum(phl[s]) && GS_IsNum(pll[s]) && phl[s] - pll[s] > 0) pos = (c[s] - pll[s]) / (phl[s] - pll[s]);
         pos = GS_Clip(pos, -0.5, 1.5);
         GS_Put("pac_pd_pos", pos - 0.5); GS_Put("pac_pd_zone", pos > 0.525 ? 1.0 : (pos < 0.475 ? -1.0 : 0.0));
        }
     }
   bool evb[], evs[]; double fnb[], fns[], fdb[], fds[], x[];
   GS_Fvg(h, l, c, atr14, n, 20, evb, evs, fnb, fns, fdb, fds);
   GS_Since(evb, n, x); GS_Put("pac_fvg_b", x[s]); GS_Since(evs, n, x); GS_Put("pac_fvg_s", x[s]);
   GS_Put("pac_fvg_n_b", fnb[s]); GS_Put("pac_fvg_n_s", fns[s]); GS_Put("pac_fvg_d_b", fdb[s]); GS_Put("pac_fvg_d_s", fds[s]);
   bool eqh[], eql[]; double lvh[], lvl[];
   GS_EqLevels(h, l, atr, n, 3, 0.1, eqh, eql, lvh, lvl);
   GS_Since(eqh, n, x); GS_Put("pac_eqh", x[s]); GS_Since(eql, n, x); GS_Put("pac_eql", x[s]);
   GS_Put("pac_eqh_d", GS_IsNum(lvh[s]) ? GS_Clip((lvh[s] - c[s]) / atr14[s], -10, 10) : 10.0);
   GS_Put("pac_eql_d", GS_IsNum(lvl[s]) ? GS_Clip((c[s] - lvl[s]) / atr14[s], -10, 10) : 10.0);
   // ---- Oscillator Matrix
   double d[], ad[], e1[], m[], e2[], a2[], hw[], sig[];
   ArrayResize(d, n); ArrayResize(ad, n);
   for(int i = 0; i < n; i++) { d[i] = i == 0 ? 0.0 : c[i] - c[i - 1]; ad[i] = MathAbs(d[i]); }
   GS_Ema(d, n, 14, e1); GS_Ema(e1, n, 7, m); GS_Ema(ad, n, 14, e2); GS_Ema(e2, n, 7, a2);
   ArrayResize(hw, n); for(int i = 0; i < n; i++) hw[i] = 50 + 50 * (a2[i] > 0 ? m[i] / a2[i] : 0.0);
   GS_RollMean(hw, n, 3, sig);
   GS_Put("om_hw", hw[s] - 50); GS_Put("om_hw_sig", hw[s] - sig[s]); GS_Put("om_hw_slope", s > 0 ? hw[s] - hw[s - 1] : 0.0);
   GS_Put("om_hw_zone", hw[s] > 80 ? 1.0 : (hw[s] < 20 ? -1.0 : 0.0));
   bool up50[], dn50[], xu[], xd[]; ArrayResize(up50, n); ArrayResize(dn50, n); ArrayResize(xu, n); ArrayResize(xd, n);
   for(int i = 0; i < n; i++)
     {
      double hp = i == 0 ? 50.0 : hw[i - 1]; up50[i] = hw[i] > 50 && hp <= 50; dn50[i] = hw[i] < 50 && hp >= 50;
      double hp2 = i == 0 ? hw[0] : hw[i - 1], sp2 = i == 0 ? sig[0] : sig[i - 1];
      xu[i] = hw[i] > sig[i] && hp2 <= sp2 && hw[i] < 30; xd[i] = hw[i] < sig[i] && hp2 >= sp2 && hw[i] > 70;
     }
   GS_Since(up50, n, x); GS_Put("om_x50_b", x[s]); GS_Since(dn50, n, x); GS_Put("om_x50_s", x[s]);
   GS_Since(xu, n, x); GS_Put("om_rev_b", x[s]); GS_Since(xd, n, x); GS_Put("om_rev_s", x[s]);
   double tp[], pv[], nv[], ps[], ns2[], mfi[], mf[]; ArrayResize(tp, n); ArrayResize(pv, n); ArrayResize(nv, n);
   for(int i = 0; i < n; i++) tp[i] = (h[i] + l[i] + c[i]) / 3;
   for(int i = 0; i < n; i++) { double dt = i == 0 ? 0.0 : tp[i] - tp[i - 1]; double vv = MathMax(v[i], 1e-9); pv[i] = dt > 0 ? tp[i] * vv : 0; nv[i] = dt < 0 ? tp[i] * vv : 0; }
   GS_RollSum(pv, n, 14, ps); GS_RollSum(nv, n, 14, ns2);
   ArrayResize(mfi, n); for(int i = 0; i < n; i++) mfi[i] = 100 * ps[i] / MathMax(ps[i] + ns2[i], 1e-12);
   GS_RollMean(mfi, n, 6, mf);
   GS_Put("om_mf", mf[s] - 50); GS_Put("om_mf_slope", s > 0 ? mf[s] - mf[s - 1] : 0.0);
   GS_Put("om_conf", ((hw[s] - 50) / 50 + (mf[s] - 50) / 50) / 2);
   GS_Put("om_conf_agree", (hw[s] > 50 && mf[s] > 50) ? 1.0 : ((hw[s] < 50 && mf[s] < 50) ? -1.0 : 0.0));
   bool dvb[], dvs[]; GS_Divergence(h, l, hw, n, 5, dvb, dvs);
   GS_Since(dvb, n, x); GS_Put("om_div_b", x[s]); GS_Since(dvs, n, x); GS_Put("om_div_s", x[s]);
   // ---- Signals & Overlays
   double atr10[], stf[], trf[], fac[], strength[]; GS_Rma(tr, n, 10, atr10);
   GS_StAi(h, l, c, atr10, n, 10.0, stf, trf, fac, strength);
   GS_Put("so_st_dir", trf[s]); GS_Put("so_st_dist", GS_Clip((c[s] - stf[s]) / MathMax(atr10[s], 1e-9), -20, 20));
   bool fb[], fs[]; ArrayResize(fb, n); ArrayResize(fs, n);
   for(int i = 0; i < n; i++) { double pt = i == 0 ? 1.0 : trf[i - 1], pt2 = i == 0 ? -1.0 : trf[i - 1]; fb[i] = trf[i] == 1 && pt == -1; fs[i] = trf[i] == -1 && pt2 == 1; }
   GS_Since(fb, n, x); GS_Put("so_st_flip_b", x[s]); GS_Since(fs, n, x); GS_Put("so_st_flip_s", x[s]);
   GS_Put("so_st_strength", GS_Clip(strength[s] * 10, 0, 10)); GS_Put("so_st_factor", fac[s]);
   double mid[], ra[]; GS_Ema(c, n, 20, mid); GS_Rma(tr, n, 20, ra);
   double zz = GS_Clip((c[s] - mid[s]) / MathMax(ra[s], 1e-9), -10, 10);
   GS_Put("so_rb_z", zz); GS_Put("so_rb_out", zz > 2 ? 1.0 : (zz < -2 ? -1.0 : 0.0));
   bool tu[], td[]; ArrayResize(tu, n); ArrayResize(td, n);
   for(int i = 0; i < n; i++) { tu[i] = h[i] >= mid[i] + 3 * ra[i]; td[i] = l[i] <= mid[i] - 3 * ra[i]; }
   GS_Since(tu, n, x); GS_Put("so_rb_touch_up", x[s]); GS_Since(td, n, x); GS_Put("so_rb_touch_dn", x[s]);
  }

//---- timeframe series built from completed H1 bars (H4 = 4 NY hours from 17:00, D1 = 17:00 NY day, D1 needs >= 10 bars)
bool GS_BuildAndCompute(datetime t0utc)
  {
   MqlRates r[]; int got = CopyRates(_Symbol, PERIOD_H1, 1, GS_InpHistBars, r);      // index 0 (current, incomplete) excluded
   if(got < GS_InpMinBars) { GS_gShNote = "history " + IntegerToString(got) + " < GS_InpMinBars H1 bars"; return false; }
   double o[], h[], l[], c[], v[]; datetime tu[];
   int n = 0; ArrayResize(o, got); ArrayResize(h, got); ArrayResize(l, got); ArrayResize(c, got); ArrayResize(v, got); ArrayResize(tu, got);
   for(int i = 0; i < got; i++)
     {
      datetime u = GS_ToUTC(r[i].time); if(u + 3600 > t0utc) continue;      // only bars complete at t0
      if(r[i].tick_volume <= 0) continue;                                  // research drops zero-volume bars
      o[n] = r[i].open; h[n] = r[i].high; l[n] = r[i].low; c[n] = r[i].close; v[n] = (double)r[i].tick_volume; tu[n] = u; n++;
     }
   if(n < GS_InpMinBars) { GS_gShNote = "usable bars " + IntegerToString(n); return false; }
   // H1
   GS_gTf = 0; GS_ComputeRaw(o, h, l, c, v, n, n - 1);
   // H4 and D1 aggregation
   datetime curKey = GS_TradingDayKey(t0utc); int curBlk = ((GS_NYHour(t0utc) - 17) % 24 + 24) % 24 / 4;
   for(int tf = 1; tf <= 2; tf++)
     {
      double tO[], tH[], tL[], tC[], tV[]; int cnt[]; int m = 0; ArrayResize(tO, n); ArrayResize(tH, n); ArrayResize(tL, n); ArrayResize(tC, n); ArrayResize(tV, n); ArrayResize(cnt, n);
      datetime pk = 0; int pb = -1; datetime lastKey = 0; int lastBlk = -1;
      for(int i = 0; i < n; i++)
        {
         datetime k = GS_TradingDayKey(tu[i]); int b = tf == 1 ? ((GS_NYHour(tu[i]) - 17) % 24 + 24) % 24 / 4 : 0;
         if(m == 0 || k != pk || b != pb) { tO[m] = o[i]; tH[m] = h[i]; tL[m] = l[i]; tC[m] = c[i]; tV[m] = v[i]; cnt[m] = 1; m++; pk = k; pb = b; }
         else { int q = m - 1; tH[q] = MathMax(tH[q], h[i]); tL[q] = MathMin(tL[q], l[i]); tC[q] = c[i]; tV[q] += v[i]; cnt[q]++; }
         lastKey = k; lastBlk = b;
        }
      // drop the group still in progress at t0 (it contains the entry bar in the research data)
      if(m > 0 && lastKey == curKey && (tf == 2 || lastBlk == curBlk)) m--;
      if(tf == 2)
        {   // D1: keep days with >= 10 bars
         int w = 0; for(int q = 0; q < m; q++) if(cnt[q] >= 10) { tO[w] = tO[q]; tH[w] = tH[q]; tL[w] = tL[q]; tC[w] = tC[q]; tV[w] = tV[q]; w++; }
         m = w;
        }
      if(m < 300) { GS_gShNote = "too few TF bars"; return false; }
      ArrayResize(tO, m); ArrayResize(tH, m); ArrayResize(tL, m); ArrayResize(tC, m); ArrayResize(tV, m);
      GS_gTf = tf; GS_ComputeRaw(tO, tH, tL, tC, tV, m, m - 1);
     }
   return true;
  }

