b_n_with", "H4_pac_sw_ob_n_against", "H4_pac_sw_ob_d_with", "H4_pac_sw_ob_d_against", "H4_pac_sw_ob_in_with", "H4_pac_sw_ob_in_against", "H4_pac_in_bos_with", "H4_pac_in_bos_against", "H4_pac_in_choch_with", "H4_pac_in_choch_against", "H4_pac_in_chochp_with", "H4_pac_in_chochp_against", "H4_pac_in_sweep_with", "H4_pac_in_sweep_against", "H4_pac_in_ob_n_with", "H4_pac_in_ob_n_against", "H4_pac_in_ob_d_with", "H4_pac_in_ob_d_against", "H4_pac_in_ob_in_with", "H4_pac_in_ob_in_against", "H4_pac_fvg_with", "H4_pac_fvg_against", "H4_pac_fvg_n_with", "H4_pac_fvg_n_against", "H4_pac_fvg_d_with", "H4_pac_fvg_d_against", "H4_pac_eqh_with", "H4_pac_eqh_against", "H4_pac_eqh_d_with", "H4_pac_eqh_d_against", "H4_om_x50_with", "H4_om_x50_against", "H4_om_rev_with", "H4_om_rev_against", "H4_om_div_with", "H4_om_div_against", "H4_so_st_flip_with", "H4_so_st_flip_against", "H4_so_rb_touch_dn_with", "H4_so_rb_touch_dn_against", "H4_align3", "D1_pac_sw_trend", "D1_pac_in_trend", "D1_pac_pd_pos", "D1_pac_pd_zone", "D1_om_hw", "D1_om_hw_sig", "D1_om_hw_slope", "D1_om_hw_zone", "D1_om_mf", "D1_om_mf_slope", "D1_om_conf", "D1_om_conf_agree", "D1_so_st_dir", "D1_so_st_dist", "D1_so_rb_z", "D1_so_rb_out", "D1_so_st_strength", "D1_so_st_factor", "D1_pac_sw_bos_with", "D1_pac_sw_bos_against", "D1_pac_sw_choch_with", "D1_pac_sw_choch_against", "D1_pac_sw_chochp_with", "D1_pac_sw_chochp_against", "D1_pac_sw_sweep_with", "D1_pac_sw_sweep_against", "D1_pac_sw_ob_n_with", "D1_pac_sw_ob_n_against", "D1_pac_sw_ob_d_with", "D1_pac_sw_ob_d_against", "D1_pac_sw_ob_in_with", "D1_pac_sw_ob_in_against", "D1_pac_in_bos_with", "D1_pac_in_bos_against", "D1_pac_in_choch_with", "D1_pac_in_choch_against", "D1_pac_in_chochp_with", "D1_pac_in_chochp_against", "D1_pac_in_sweep_with", "D1_pac_in_sweep_against", "D1_pac_in_ob_n_with", "D1_pac_in_ob_n_against", "D1_pac_in_ob_d_with", "D1_pac_in_ob_d_against", "D1_pac_in_ob_in_with", "D1_pac_in_ob_in_against", "D1_pac_fvg_with", "D1_pac_fvg_against", "D1_pac_fvg_n_with", "D1_pac_fvg_n_against", "D1_pac_fvg_d_with", "D1_pac_fvg_d_against", "D1_pac_eqh_with", "D1_pac_eqh_against", "D1_pac_eqh_d_with", "D1_pac_eqh_d_against", "D1_om_x50_with", "D1_om_x50_against", "D1_om_rev_with", "D1_om_rev_against", "D1_om_div_with", "D1_om_div_against", "D1_so_st_flip_with", "D1_so_st_flip_against", "D1_so_rb_touch_dn_with", "D1_so_rb_touch_dn_against", "D1_align3", "mtf_pac_votes", "mtf_om_votes", "mtf_so_votes", "mtf_align3_majority", "mtf_align9"};
void GS_Assemble(double side, double &out[])
  {
   out[0] = GS_RAW[0][0] * side;
   out[1] = GS_RAW[0][1] * side;
   out[2] = GS_RAW[0][2] * side;
   out[3] = GS_RAW[0][3] * side;
   out[4] = GS_RAW[0][4] * side;
   out[5] = GS_RAW[0][5] * side;
   out[6] = GS_RAW[0][6] * side;
   out[7] = GS_RAW[0][7] * side;
   out[8] = GS_RAW[0][8] * side;
   out[9] = GS_RAW[0][9] * side;
   out[10] = GS_RAW[0][10] * side;
   out[11] = GS_RAW[0][11] * side;
   out[12] = GS_RAW[0][12] * side;
   out[13] = GS_RAW[0][13] * side;
   out[14] = GS_RAW[0][14] * side;
   out[15] = GS_RAW[0][15] * side;
   out[16] = GS_RAW[0][16];
   out[17] = GS_RAW[0][17];
   out[18] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][18] : GS_RAW[0][19]), 999.0));
   out[19] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][19] : GS_RAW[0][18]), 999.0));
   out[20] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][20] : GS_RAW[0][21]), 999.0));
   out[21] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][21] : GS_RAW[0][20]), 999.0));
   out[22] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][22] : GS_RAW[0][23]), 999.0));
   out[23] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][23] : GS_RAW[0][22]), 999.0));
   out[24] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][24] : GS_RAW[0][25]), 999.0));
   out[25] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][25] : GS_RAW[0][24]), 999.0));
   out[26] = (side > 0 ? GS_RAW[0][26] : GS_RAW[0][27]);
   out[27] = (side > 0 ? GS_RAW[0][27] : GS_RAW[0][26]);
   out[28] = (side > 0 ? GS_RAW[0][28] : GS_RAW[0][29]);
   out[29] = (side > 0 ? GS_RAW[0][29] : GS_RAW[0][28]);
   out[30] = (side > 0 ? GS_RAW[0][30] : GS_RAW[0][31]);
   out[31] = (side > 0 ? GS_RAW[0][31] : GS_RAW[0][30]);
   out[32] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][32] : GS_RAW[0][33]), 999.0));
   out[33] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][33] : GS_RAW[0][32]), 999.0));
   out[34] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][34] : GS_RAW[0][35]), 999.0));
   out[35] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][35] : GS_RAW[0][34]), 999.0));
   out[36] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][36] : GS_RAW[0][37]), 999.0));
   out[37] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][37] : GS_RAW[0][36]), 999.0));
   out[38] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][38] : GS_RAW[0][39]), 999.0));
   out[39] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][39] : GS_RAW[0][38]), 999.0));
   out[40] = (side > 0 ? GS_RAW[0][40] : GS_RAW[0][41]);
   out[41] = (side > 0 ? GS_RAW[0][41] : GS_RAW[0][40]);
   out[42] = (side > 0 ? GS_RAW[0][42] : GS_RAW[0][43]);
   out[43] = (side > 0 ? GS_RAW[0][43] : GS_RAW[0][42]);
   out[44] = (side > 0 ? GS_RAW[0][44] : GS_RAW[0][45]);
   out[45] = (side > 0 ? GS_RAW[0][45] : GS_RAW[0][44]);
   out[46] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][46] : GS_RAW[0][47]), 999.0));
   out[47] = MathLog(1.0 + MathMin((side > 0 ? GS_RAW[0][47] : GS_RAW[0][46]), 999.0));
   out[48] = (side > 0 ? GS_RAW[0][48] : GS_RAW[0][49]);
